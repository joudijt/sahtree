RewriteEngine On

# If a visitor or link hits the .html URL directly, 301 to the clean version
# (keeps one canonical URL per page — avoids duplicate-content SEO issues).
RewriteCond %{THE_REQUEST} \s/+(.+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Serve the matching .html file for extensionless requests.
# No !-d guard on purpose: /blog is both a clean URL (blog.html) and a real
# directory (blog/). With !-d the rewrite is skipped, mod_dir 301s /blog -> /blog/
# and Apache serves a directory listing instead of the blog index (200, so a
# status-code-only check misses it). Same for /ms/blog.
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

# Never fall back to an autoindex listing.
Options -Indexes

# llms.txt (and every other .txt) is UTF-8 and carries Arabic. Without this the
# host serves "Content-Type: text/plain" with NO charset, and a consumer is free
# to decode it as latin-1 — the Arabic then arrives as mojibake. Verified: the
# live response had no charset before this line was added.
# AddCharset alone was NOT enough on this host (LiteSpeed): after deploying it the
# response still came back as bare "text/plain". AddType sets the full media type
# including the charset parameter and IS honoured — but it does not show up on the
# very next request, so re-check a few minutes later before concluding it failed.
# Verified live 2026-08-14: "content-type: text/plain; charset=UTF-8" on all three
# llms files. Keep both lines.
AddCharset UTF-8 .txt
AddType "text/plain; charset=UTF-8" .txt

# Neither of the two lines above reliably changes the wire format on this host —
# one recheck showed "charset=UTF-8" and later requests went back to bare
# "text/plain" (not a cache: a cache-busting query string returns bare too, and
# the response carries "vary: User-Agent", so an edge layer is involved).
# mod_headers rewrites the response header after the type is chosen, which is the
# one place that layer cannot undo. Verify with: curl -sI https://sihatree.com/llms.txt
<IfModule mod_headers.c>
  <FilesMatch "\.txt$">
    Header set Content-Type "text/plain; charset=UTF-8"
  </FilesMatch>
</IfModule>
